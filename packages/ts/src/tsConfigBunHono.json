{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Bun + Hono",
  "extends": "./tsConfigBase.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "incremental": false
  }
}