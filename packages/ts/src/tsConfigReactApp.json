{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React App",
  "extends": "./tsConfigBase.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // "types": [
    //   "vite/client"
    // ]
  }
}