# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TurboRepo
.turbo
.turbo-temp
dist/
.next/

**/.tanstack

# testing
/coverage

